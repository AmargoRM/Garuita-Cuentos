      "dialogo": [
        { "quien": "mono", "dice": "¡Mmm… mangos! ¡Bien amarillitos! Pero están tan altos…" },
        { "quien": "mono", "dice": "¡Ja, ja! ¡No importa! ¡Yo tengo puntería!" }
      ]
    },
    {
      "lugar": "bosque",
      "palabra": "¡GOZA!",
