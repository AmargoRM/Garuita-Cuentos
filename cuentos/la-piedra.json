      "personajes": [
        { "id": "tigre", "accion": "rugir", "entrada": "ya" },
        { "id": "gallina", "accion": "anotar", "entrada": "aparece" }
      ],
      "dialogo": [
        { "quien": "tigre", "dice": "¡Ja! ¡Se fueron! ¡Nadie se mete con Bruno!" },
        { "quien": "gallina", "dice": "Apunto: Tigre Bruno espantó a los zopilotes. Goza…" }
      ]
    },
    {
      "lugar": "bosque",
      "palabra": "¡NO GOZA!",
      "palabra_linea": 4,
      "musica": "silencio",
      "palo": "grande",
      "personajes": [
        { "id": "tigre", "accion": "hablar", "entrada": "ya" },
        { "id": "tortuga", "accion": "hablar", "entrada": "derecha" },
        { "id": "gallina", "accion": "anotar", "entrada": "ya" }
      ],
      "dialogo": [
        { "quien": "tigre", "dice": "¿Eh? ¿Y los pajaritos que cantaban?" },
        { "quien": "tigre", "dice": "Tan bonito que cantaban… y ahora todo calladito." },
        { "quien": "tortuga", "dice": "Bruno, con el rugido también se fueron ellos. Y los zopilotes limpian el monte, ¿sabía?" },
        { "quien": "gallina", "dice": "…¡y no goza! ¡Co-co!" }
      ]
    },
    {
      "lugar": "pueblito",
      "palabra": "LA LIBRETITA",
      "musica": "tranquila",
      "sonidos": [{ "id": "gallina", "en": "inicio", "vol": 0.6 }],
      "personajes": [
        { "id": "mono", "accion": "quieto", "entrada": "ya" },
        { "id": "gallina", "accion": "anotar", "entrada": "ya" },
        { "id": "conejo", "accion": "quieto", "entrada": "ya" },
        { "id": "tigre", "accion": "quieto", "entrada": "ya" }
      ],
      "dialogo": [
        { "quien": "gallina", "dice": "¡Co-co! ¡Escuchen todos! Chito: goza mangos, no goza ramas. Chepe: goza hoy, no goza mañana. Bruno: goza silencio, no goza cantos." },
        { "quien": "mono", "dice": "¡Uy! ¡Qué libretita tan chismosa!" }
      ]
    },
    {
      "lugar": "bosque",
      "palabra": "¡PENSÁ ANTES!",
      "palabra_linea": 1,
      "musica": "tranquila",
      "palo": "grande",
      "pajaritos": 5,
      "vuelven": true,
      "sonidos": [{ "id": "pajaros", "en": "vuelven", "vol": 0.9 }],
      "personajes": [
        { "id": "mono", "accion": "hablar", "entrada": "ya" },
        { "id": "tortuga", "accion": "hablar", "entrada": "ya" },
        { "id": "conejo", "accion": "hablar", "entrada": "ya" },
        { "id": "tigre", "accion": "hablar", "entrada": "ya" }
      ],
      "dialogo": [
        { "quien": "tortuga", "dice": "Todo lo que hacemos tiene un goza… y un no goza. Antes de hacer algo, pensemos: ¿quién no va a gozar después?" },
        { "quien": "mono", "dice": "¡Ya sé! ¡Espero a que los mangos caigan solitos!" },
        { "quien": "conejo", "dice": "¡Y yo siembro más, y me como una zanahoria por día!" },
        { "quien": "tigre", "dice": "Pajaritos… vuelvan… porfa." }
      ]
    },
    {
      "lugar": "bosque",
      "palabra": "¡CO-CO-CO!",
      "musica": "accion",
      "sonidos": [{ "id": "gallina", "en": "salida", "vol": 0.9 }],
      "personajes": [
        { "id": "gallina", "accion": "correr", "entrada": "ya", "salida": "derecha" },
        { "id": "tortuga", "accion": "hablar", "entrada": "ya" }
      ],
      "dialogo": [
        { "quien": "gallina", "dice": "¡Co-co-co! ¡Esto lo tiene que saber todo el monte!" },
        { "quien": "tortuga", "dice": "Ay, Clota… ya va a regar el cuento por todo el monte." }
      ]
    },
    {
      "lugar": "pueblito",
      "palabra": "¿Y VOS?",
      "musica": "tranquila",
      "personajes": [{ "id": "conejo", "accion": "saludar", "entrada": "aparece" }],
      "dialogo": [{ "quien": "conejo", "dice": "¿Y vos? ¿Qué hiciste hoy que goza… y no goza?" }]
    }
  ]
