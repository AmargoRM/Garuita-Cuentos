    {
      "lugar": "bosque",
      "palabra": "¡NO GOZA!",
      "palabra_linea": 5,
      "musica": "accion",
      "palo": "mango",
      "mangos": 3,
      "rama": true,
      "golpe": "tortuga",
      "personajes": [
        { "id": "mono", "accion": "apedrear", "veces": 1, "entrada": "ya" },
        { "id": "tortuga", "accion": "quieto", "entrada": "ya" },
        { "id": "gallina", "accion": "anotar", "entrada": "ya" }
      ],
      "dialogo": [
        { "quien": "tortuga", "dice": "¡Ay! ¡Mi caparazón!" },
        { "quien": "mono", "dice": "¡Uy! ¡Tula! ¿Estás bien? ¡No te vi!" },
        { "quien": "tortuga", "dice": "Estoy bien, Chito. Pero mirá el palo… quebraste las ramas. El otro año va a dar menos mangos." },
        { "quien": "mono", "dice": "Ay… no pensé en eso." },
        { "quien": "gallina", "dice": "…¡y no goza! ¡Co-co!" }
      ]
    },
    {
      "lugar": "pueblito",
      "palabra": "¡GOZA!",
      "palabra_linea": 4,
      "musica": "accion",
      "huerto": { "zanahorias": 8, "comer": true },
      "personajes": [
        { "id": "conejo", "accion": "comer", "entrada": "izquierda" },
        { "id": "gallina", "accion": "anotar", "entrada": "aparece" }
      ],
      "dialogo": [
        { "quien": "conejo", "dice": "¡Zanahorias! ¡Una! ¡Dos! ¡Tres! ¡Todas para mí!" },
        { "quien": "gallina", "dice": "¡Co-co! Chepe, ¿no va a guardar unas para mañana?" },
        { "quien": "conejo", "dice": "¿Mañana? ¡Mañana es mañana! ¡Hoy es hoy!" },
        { "quien": "gallina", "dice": "Apunto: Conejo Chepe, panza llena. Goza…" }
      ]
    },
    {
      "lugar": "pueblito",
      "texto": "Al día siguiente…",
      "palabra": "¡NO GOZA!",
      "palabra_linea": 3,
      "musica": "triste",
      "huerto": { "zanahorias": 0 },
      "sonidos": [{ "id": "gallo", "en": "inicio", "vol": 0.8 }],
      "personajes": [
        { "id": "conejo", "accion": "hablar", "entrada": "ya" },
        { "id": "gallina", "accion": "anotar", "entrada": "aparece" }
      ],
      "dialogo": [
        { "quien": "conejo", "dice": "¿Y mis zanahorias? ¿Dónde están? ¡Tengo hambre!" },
        { "quien": "conejo", "dice": "Ay… ya me acordé. Me las comí todas ayer." },
        { "quien": "gallina", "dice": "…¡y no goza! ¡Co-co!" }
