      "personajes": [{ "id": "tigre", "accion": "hablar", "entrada": "izquierda" }],
      "dialogo": [
        { "quien": "tigre", "dice": "¡Puaj! ¡Zopilotes en mi palo! ¡Qué feos!" },
        { "quien": "tigre", "dice": "¡Ahora van a ver quién manda aquí!" }
      ]
    },
    {
      "lugar": "bosque",
      "palabra": "¡GOZA!",
      "palabra_linea": 2,
      "musica": "accion",
      "palo": "grande",
      "zopilotes": 3,
