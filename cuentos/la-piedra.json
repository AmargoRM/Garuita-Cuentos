        { "id": "gallina", "accion": "anotar", "entrada": "aparece" }
      ],
      "dialogo": [
        { "quien": "mono", "dice": "¡Uno! ¡Dos! ¡Tres mangos! ¡Ñam, ñam!" },
        { "quien": "gallina", "dice": "¡Co-co! A ver… Mono Chito tiene mangos. Goza…" },
        { "quien": "mono", "dice": "¡Goza, goza! ¡Ja, ja!" },
        { "quien": "mono", "dice": "¡Ahora una piedra GRANDOTA para el más grande!" }
      ]
